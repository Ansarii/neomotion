<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base application theme.
        windowBackground is set to black so there is no white flash while
        Compose renders the first frame. The Compose NeoMotionTheme handles
        all further styling.
    -->
    <style name="Theme.NeoMotion" parent="android:Theme.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
